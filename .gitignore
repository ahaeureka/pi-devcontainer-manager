# Dependencies
node_modules/

# Build output. `dist/` is COMMITTED on purpose: Pi installs git packages with
# `npm install --omit=dev`, so a git source must carry a working entry point without a
# build toolchain. CI asserts the committed output matches a fresh build.
*.tgz

# Pi machine-local state
.pi/remote-pi/

# Scratch (workflow temp files)
.rpiv/tmp/

# Logs / OS
*.log
.DS_Store

# Project-local pi install state (machine-specific absolute paths)
.pi/settings.json
# Machine-local dev escape hatch (hostExecution.allow while developing this extension)
.pi/pi-devcontainer-manager.json
