{
  "name": "pi-devcontainer-manager",
  "version": "1.0.0",
  "description": "Host-side Pi extension for governed multi-DevContainer discovery and execution",
  "type": "module",
  "main": "./dist/extensions/index.js",
  "types": "./dist/extensions/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./dsh": {
      "types": "./dist/extensions/dsh/index.d.ts",
      "import": "./dist/extensions/dsh/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs",
    "examples",
    "cordis.patch.yml"
  ],
  "keywords": [
    "pi-package",
    "pi-extension",
    "devcontainer",
    "docker"
  ],
  "author": "pi-devcontainer-manager contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahaeureka/pi-devcontainer-manager.git"
  },
  "homepage": "https://github.com/ahaeureka/pi-devcontainer-manager#readme",
  "bugs": {
    "url": "https://github.com/ahaeureka/pi-devcontainer-manager/issues"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest --run",
    "test:unit": "vitest --run tests/unit",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepare": "node scripts/prepare-package.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@devcontainers/cli": "0.88.0",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  }
}
